                source: 1
                datatype: float64
                byteorder: little
                shape: [1254]
            inputs: [x0, x1, x]
            outputs: [y0, y1, y]
          inputs: [x0]
          inverse: !transform/compose-1.3.0
            forward:
            - !transform/remap_axes-1.4.0
              inputs: [x0, x1, x2]
              mapping: [2]
              outputs: [x0]
